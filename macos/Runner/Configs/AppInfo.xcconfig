// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = ZEON

// The application's bundle identifier
MACOS_BUNDLE_IDENTIFIER = app.zeon.ios
MACOS_DEVELOPMENT_TEAM =

// Keep developer credentials outside git. Copy AppleSigning.xcconfig.example
// to AppleSigning.xcconfig and fill it in before creating signed macOS builds.
#include? "AppleSigning.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(MACOS_BUNDLE_IDENTIFIER)
DEVELOPMENT_TEAM = $(MACOS_DEVELOPMENT_TEAM)
BASE_BUNDLE_IDENTIFIER = $(MACOS_BUNDLE_IDENTIFIER)
// Method/Event channel namespace. This must match the Dart channel prefix and
// intentionally cannot be overridden by the local signing configuration.
SERVICE_IDENTIFIER = com.zeon.app
ZEON_FLUTTER_ENVIRONMENT = dev
OTHER_LDFLAGS = $(inherited) -lresolv

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2023 zeon.com. All rights reserved.
